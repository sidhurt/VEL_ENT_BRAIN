# Copy to .env and fill in. Never commit .env (root .gitignore covers it).

# --- Neo4j (required — the app throws at startup without these) -------------
# Shared instance for both constitutional planes (V1 Derogation D1).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Optional per-plane overrides (separate infrastructure per plane).
# NEO4J_PERSONAL_URI=
# NEO4J_PERSONAL_USER=
# NEO4J_PERSONAL_PASSWORD=
# NEO4J_PERSONAL_DATABASE=
# NEO4J_ORG_URI=
# NEO4J_ORG_USER=
# NEO4J_ORG_PASSWORD=
# NEO4J_ORG_DATABASE=

# --- Auth --------------------------------------------------------------------
# Required in production (startup fails without it). In dev an ephemeral
# secret is generated, so tokens die on restart.
JWT_SECRET=

# Comma-separated principal ids allowed through the admin gate.
# No production default: unset means all admin routes return 403.
# Non-production defaults to 'enterprise-admin'.
ADMIN_PRINCIPALS=

# Dev login (identity-asserted, no credential) in production. Leave unset
# unless the admin console still needs it. Any value other than 'true' = off.
# ALLOW_DEV_LOGIN=true

# Google OAuth client id (public; ships in the frontend bundle). Defaults to
# the project's own client id — override for your own deployment.
# GOOGLE_CLIENT_ID=

# --- LLM ---------------------------------------------------------------------
# Unset = LLM features degrade gracefully (no generation, keyword-only retrieval).
OPENAI_API_KEY=
# EXTRACTION_MODEL=gpt-4o-mini
# GENERATION_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BACKFILL_BATCH_SIZE=50

# --- Server ------------------------------------------------------------------
# PORT=3000

# Seed script safety: seed wipes the graph and refuses to run unless this is set.
# SEED_ALLOW_WIPE=true

# Copy to .env and fill in. Vite inlines VITE_* values into the bundle at
# build time — nothing here is secret, but never put secrets in VITE_ vars.

# Backend API base URL (defaults to the local dev backend).
VITE_API_URL=http://localhost:3000/api

# Google OAuth client id for Sign-In (public; must match the backend's
# GOOGLE_CLIENT_ID). Defaults to the project's own client id.
# VITE_GOOGLE_CLIENT_ID=

# Principal id the admin console logs in as via dev login
# (non-production default: enterprise-admin).
# VITE_ADMIN_PRINCIPAL=
